{
  "name": "work-cockpit",
  "version": "1.0.0",
  "private": true,
  "description": "Regression test environment for the Work Cockpit single-page application",
  "scripts": {
    "test": "npm run test:static && npm run test:browser",
    "test:static": "node qa-regression.js index.html && node qa-reliability.js",
    "test:browser": "node qa-browser.js && node qa-workflow-browser.js",
    "setup:cloud": "playwright install chromium"
  },
  "dependencies": {
    "quill": "2.0.3",
    "sortablejs": "1.15.6"
  },
  "devDependencies": {
    "playwright": "1.55.0"
  }
}

